# РЕЗЕРВНЫЙ СЕРВЕР

# Основной API (ASP.NET Core с SSL)
VITE_API_USE_HTTPS=true
VITE_API_HTTPS_URL=https://api.zno-nmt.com.ua/api/ # works !!! with linux server (https GLOBAL_NET)

# Резервный API (PHP/Laravel с SSL)
VITE_FALLBACK_API_USE_HTTPS=true
VITE_FALLBACK_API_HTTPS_URL=https://php.zno-nmt.com.ua/api/ # works !!! with hosting 

# Настройки
VITE_API_TIMEOUT=10000
VITE_API_HEALTH_CHECK_INTERVAL=30000