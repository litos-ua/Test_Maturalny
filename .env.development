# РЕЗЕРВНЫЙ СЕРВЕР

# Основной API (локальный или сетевой)
VITE_API_USE_HTTPS=false
VITE_API_HTTP_URL=//localhost:5000/api/

# Резервный API (PHP/Laravel с SSL)
VITE_FALLBACK_API_USE_HTTPS=true
VITE_FALLBACK_API_HTTPS_URL=https://php.zno-nmt.com.ua/api/

# Настройки
VITE_API_TIMEOUT=10000
VITE_API_HEALTH_CHECK_INTERVAL=30000

