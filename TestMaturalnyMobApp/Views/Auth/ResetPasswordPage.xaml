<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TestMaturalnyMobApp.Components"
             x:Class="TestMaturalnyMobApp.Views.Auth.ResetPasswordPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightAuthBackground}, Dark={StaticResource DarkAuthBackground}}"
             Title="Скидання пароля">

    <views:LayoutView>
        <views:LayoutView.PageContent>
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

                    <Label Text="Скидання пароля"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>

                    <Label Text="Введіть новий пароль"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}"/>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           IsVisible="{Binding HasError}"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding SuccessMessage}"
                           TextColor="Green"
                           IsVisible="{Binding HasSuccess}"
                           HorizontalOptions="Center"/>

                    <!-- Новый пароль -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="Новий пароль"
                               Text="{Binding NewPassword}"
                               IsPassword="{Binding ShowNewPassword, Converter={StaticResource InverseBoolConverter}}"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>

                        <ImageButton Grid.Column="1"
                                     Source="eye_icon.png"
                                     Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                     WidthRequest="40"
                                     HeightRequest="40"/>
                    </Grid>

                    <!-- Подтверждение пароля -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="Підтвердження пароля"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="{Binding ShowConfirmPassword, Converter={StaticResource InverseBoolConverter}}"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>

                        <ImageButton Grid.Column="1"
                                     Source="eye_icon.png"
                                     Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                     WidthRequest="40"
                                     HeightRequest="40"/>
                    </Grid>

                    <Button Text="Скинути пароль"
                            Command="{Binding ResetPasswordCommand}"
                            IsEnabled="{Binding IsNotLoading}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimaryButtonBg}, Dark={StaticResource DarkPrimaryButtonBg}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightPrimaryButtonText}, Dark={StaticResource DarkPrimaryButtonText}}"
                            CornerRadius="8"
                            HeightRequest="50"/>

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="Повернутися до входу"
                                Command="{Binding NavigateToLoginCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource LightPrimaryButtonBg}, Dark={StaticResource DarkPrimaryButtonBg}}"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </views:LayoutView.PageContent>
    </views:LayoutView>
</ContentPage>