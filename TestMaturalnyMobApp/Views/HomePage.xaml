<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TestMaturalnyMobApp.Components"
             xmlns:components="clr-namespace:TestMaturalnyMobApp.Components"
             x:Class="TestMaturalnyMobApp.Views.HomePage"
             Title="Home">

    <views:LayoutView>
        <views:LayoutView.PageContent>
            <ScrollView>
                <VerticalStackLayout Spacing="8" Padding="12">

                    <components:HeroSection HeightRequest="{OnIdiom Phone=180, Tablet=200, Desktop=220}" />

                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackgroundColor}, Dark={StaticResource DarkPageBackgroundColor}}"
                           CornerRadius="10"
                           Padding="4"
                           HasShadow="False">
                        <Label Text="Ласкаво просимо на платформу знань."
                               FontAttributes="Bold"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                    </Frame>

                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource LightAnimatedTexBackgroundColor}, Dark={StaticResource DarkAnimatedTexBackgroundColor}}"
                           CornerRadius="10"
                           Padding="12"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="6">
                            <components:AnimatedTextBlock 
                                x:Name="MyAnimatedText"
                                Texts="{Binding AnimatedTexts}"
                                ColorPairs="{Binding AnimatedColorPairs}"
                                Interval="8000"
                                FontSize="20"
                                FontWeight="700"
                                TextAlignment="Center"
                                TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Преимущества -->
                    <VerticalStackLayout Spacing="8">
                        <Frame BackgroundColor="{AppThemeBinding Light=#FFDAB9, Dark=#191970}"
                               CornerRadius="10" 
                               Padding="12"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="📐 Актуальні дисципліни"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                                <Label Text="Постійно оновлювана база знань з математики, історії, фізики та інших предметів."
                                       FontSize="11"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame BackgroundColor="{AppThemeBinding Light=#FFDAB9, Dark=#191970}"
                               CornerRadius="10" 
                               Padding="12"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="❓ Різні типи питань"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                                <Label Text="Одна/кілька відповідей, зіставлення, коректна послідовність"
                                       FontSize="11"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame BackgroundColor="{AppThemeBinding Light=#FFDAB9, Dark=#191970}"
                               CornerRadius="10" 
                               Padding="12"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="📊 Статистика та прогрес"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                                <Label Text="Відстежуйте свої результати та досягайте більшого"
                                       FontSize="11"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </views:LayoutView.PageContent>
    </views:LayoutView>
</ContentPage>