<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewsbase="clr-namespace:TestMaturalnyMobApp.Components"
             xmlns:views="clr-namespace:TestMaturalnyMobApp.Views"
             x:Class="TestMaturalnyMobApp.Views.ExamRulesPage"
             Title="Правила тестування"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackgroundColor}, Dark={StaticResource DarkPageBackgroundColor}}">

    <viewsbase:LayoutView>
        <viewsbase:LayoutView.PageContent>
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="Правила проведення ЗНО / НМТ"
                           FontSize="20"
                           FontAttributes="Bold"
                           Margin="0,0,0,12"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>

                    <CollectionView ItemsSource="{Binding QuestionTypes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- ✅ Добавлен BackgroundColor с адаптацией под тему -->
                                <Frame BorderColor="{AppThemeBinding Light={StaticResource LightDividerColor}, Dark={StaticResource DarkDividerColor}}"
                                       Padding="12" 
                                       Margin="0,6"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackgroundColor}, Dark={StaticResource DarkCardBackgroundColor}}"
                                       CornerRadius="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}"/>
                                        <Label Text="{Binding Short}" 
                                               FontSize="14" 
                                               Margin="0,4,0,8"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}"/>
                                        <Button Text="Докладніше про оцінювання"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type views:ExamRulesPage}}, Path=BindingContext.ShowDetailsCommand}"
                                                CommandParameter="{Binding}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryButtonBg}, Dark={StaticResource DarkSecondaryButtonBg}}"
                                                TextColor="{AppThemeBinding Light={StaticResource LightSecondaryButtonText}, Dark={StaticResource DarkSecondaryButtonText}}"
                                                FontSize="14"
                                                CornerRadius="8"
                                                Padding="12,6"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </viewsbase:LayoutView.PageContent>
    </viewsbase:LayoutView>
</ContentPage>
