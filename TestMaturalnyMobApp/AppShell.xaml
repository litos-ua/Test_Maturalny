<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TestMaturalnyMobApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TestMaturalnyMobApp.Views"
    xmlns:auth="clr-namespace:TestMaturalnyMobApp.Views.Auth"
    Title="TestMaturalnyMobApp"
    Shell.NavBarIsVisible="False"
    PresentationMode="NotAnimated">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <ShellContent
        Title="TestSelection"
        ContentTemplate="{DataTemplate views:TestSelectionPage}"
        Route="TestSelectionPage" />
    <ShellContent
        Title="TestSession"
        ContentTemplate="{DataTemplate views:TestSessionPage}"
        Route="TestSessionPage" />
    <ShellContent
        Title="ExamRules"
        ContentTemplate="{DataTemplate views:ExamRulesPage}"
        Route="ExamRulesPage" />
    <ShellContent
        Title="SubjectsPage"
        ContentTemplate="{DataTemplate views:SubjectsPage}"
        Route="SubjectsPage" />
    <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate views:AboutPage}"
        Route="AboutPage" />
    <!-- ===== ✅ НОВЫЕ МАРШРУТЫ ДЛЯ АУТЕНТИФИКАЦИИ ===== -->
    <ShellContent 
        Title="Login"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="LoginPage" />

    <ShellContent 
        Title="Register"
        ContentTemplate="{DataTemplate auth:RegisterPage}"
        Route="RegisterPage" />

    <ShellContent 
        Title="ForgotPassword"
        ContentTemplate="{DataTemplate auth:ForgotPasswordPage}"
        Route="ForgotPasswordPage" />

    <ShellContent 
        Title="ResetPassword"
        ContentTemplate="{DataTemplate auth:ResetPasswordPage}"
        Route="ResetPasswordPage" />
    <!-- ===================================================== -->

</Shell>
