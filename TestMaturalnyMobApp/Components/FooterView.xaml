<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestMaturalnyMobApp.Components.FooterView">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightFooterBackgroundColor}, Dark={StaticResource DarkFooterBackgroundColor}}">
        <VerticalStackLayout Spacing="5" Padding="10">

            <!-- ✅ Укрупненные кнопки -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Головна" 
                        Clicked="OnGoHome"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource LightFooterTextColor}, Dark={StaticResource DarkFooterTextColor}}"
                        BackgroundColor="Transparent"
                        Padding="8,6"/>

                <Button Text="Тест" 
                        Clicked="OnGoTest"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource LightFooterTextColor}, Dark={StaticResource DarkFooterTextColor}}"
                        BackgroundColor="Transparent"
                        Padding="8,6"/>

                <Button Text="Про платформу" 
                        Clicked="OnGoAbout"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource LightFooterTextColor}, Dark={StaticResource DarkFooterTextColor}}"
                        BackgroundColor="Transparent"
                        Padding="8,6"/>

                <Button Text="Контакти" 
                        Clicked="OnGoContacts"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource LightFooterTextColor}, Dark={StaticResource DarkFooterTextColor}}"
                        BackgroundColor="Transparent"
                        Padding="8,6"/>
            </HorizontalStackLayout>

            <Label Text="© 2026 Тестова платформа. Всі права захищені."
                   FontSize="11"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightFooterTextColor}, Dark={StaticResource DarkFooterTextColor}}"/>
        </VerticalStackLayout>
    </Border>
</ContentView>

    

    
    