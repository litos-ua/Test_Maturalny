<components:QuestionBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:components="clr-namespace:TestMaturalnyMobApp.Components.Questions"
                         xmlns:controls="clr-namespace:TestMaturalnyMobApp.Components"
                         xmlns:mathControls="clr-namespace:TestMaturalnyMobApp.Controls"
                         xmlns:models="clr-namespace:TestMaturalnyMobApp.Models"
                         xmlns:converters="clr-namespace:TestMaturalnyMobApp.Converters"
                         xmlns:formula="clr-namespace:TestMaturalnyMobApp.Controls"
                         x:Class="TestMaturalnyMobApp.Components.Questions.QuestionMatching"
                         x:Name="this">

    <ScrollView Orientation="Vertical">
        <VerticalStackLayout Spacing="16">

            <!-- Левые опции -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LeftItems, Source={x:Reference this}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" 
                              ColumnSpacing="10"
                              BackgroundColor="{Binding SelectedBackgroundColor}">
                            <!-- Номер -->
                            <Label Grid.Column="0"
                                   Text="{Binding Number}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{Binding SelectedTextColor}"/>

                            <!-- Контент элемента -->
                            <Grid Grid.Column="1">

                                <!-- Изображение -->
                                <controls:ZoomableImage 
                                    IsVisible="{Binding IsImage}"
                                    Source="{Binding Text}" 
                                    MaxHeight="150"
                                    MaxWidth="200"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                                <!-- Текст с inline-формулами + ограничение высоты с прокруткой -->
                                <ScrollView 
                                    Orientation="Vertical"
                                    IsVisible="{Binding IsImage, Converter={StaticResource InverseBoolConverter}}"
                                    MaximumHeightRequest="180"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Fill">

                                    <mathControls:MathRichText 
                                        Text="{Binding Text}"
                                        TextSize="15"
                                        BaseHeight="40"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        AutoWidth="False"/>
                                </ScrollView>
                            </Grid>

                            <!-- Пикер с буквами -->
                            <Picker Grid.Column="2"
                                    Title="Виберіть"
                                    ItemsSource="{Binding RightOptions}"
                                    SelectedIndex="{Binding SelectedIndex}"
                                    SelectedIndexChanged="OnPickerSelectedChanged"
                                    WidthRequest="80"
                                    TextColor="{Binding SelectedTextColor}"
                                    TitleColor="{AppThemeBinding Light={StaticResource LightOptionsLabelColor}, Dark={StaticResource DarkOptionsLabelColor}}"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>


            <!-- Правые опции -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RightItems, Source={x:Reference this}}">
                <Label Text="Праві варіанти:" FontAttributes="Bold" 
                                              FontSize="16"
                                              TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}"/>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" 
                              ColumnSpacing="8"
                              BackgroundColor="{Binding SelectedBackgroundColor}">
                            <!-- Буква -->
                            <Label Grid.Column="0"
                                   Text="{Binding Letter}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{Binding SelectedTextColor}"/>

                            <!-- Контент правой опции -->
                            <Grid Grid.Column="1">

                                <!-- Изображение -->
                                <controls:ZoomableImage 
                                    IsVisible="{Binding IsImage}"
                                    Source="{Binding Text}" 
                                    MaxHeight="150"
                                    MaxWidth="200"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                                <!-- Текст с inline-формулами + ограничение высоты с прокруткой -->
                                <ScrollView 
                                    Orientation="Vertical"
                                    IsVisible="{Binding IsImage, Converter={StaticResource InverseBoolConverter}}"
                                    MaximumHeightRequest="180"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Fill">

                                    <mathControls:MathRichText 
                                        Text="{Binding Text}"
                                        TextSize="15"
                                        BaseHeight="40"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"/>
                                </ScrollView>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>


        </VerticalStackLayout>
    </ScrollView>

</components:QuestionBase>
