
<!-- Компонент с заменой FlexLayout/MathFormulaView/Label на один MathRichText -->
    
<components:QuestionBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:components="clr-namespace:TestMaturalnyMobApp.Components.Questions"
                         xmlns:controls="clr-namespace:TestMaturalnyMobApp.Components"
                         xmlns:mathControls="clr-namespace:TestMaturalnyMobApp.Controls"
                         xmlns:models="clr-namespace:TestMaturalnyMobApp.Models"
                         xmlns:converters="clr-namespace:TestMaturalnyMobApp.Converters"
                         xmlns:formula="clr-namespace:TestMaturalnyMobApp.Controls"
                         x:Class="TestMaturalnyMobApp.Components.Questions.QuestionSingleChoice"
                         x:Name="this">

    <VerticalStackLayout Spacing="8">

        <Label Text="Оберіть одну правильну відповідь:" 
               FontSize="16" 
               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}"/>

        <ScrollView Orientation="Horizontal">

            <StackLayout BindableLayout.ItemsSource="{Binding Options, Source={x:Reference this}}"
                         Spacing="8">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:AnswerOption">

                        <!-- ФОН ОПЦИИ (родительский Grid) -->
                        <Grid ColumnDefinitions="Auto,*" 
                              ColumnSpacing="8"
                              BackgroundColor="{AppThemeBinding Light={StaticResource LightOptionsBackgroundColor}, Dark={StaticResource DarkOptionsBackgroundColor}}"
                              Padding="8,4">

                            <!-- RadioButton -->
                            <RadioButton Grid.Column="0"
                                         Value="{Binding Id}"
                                         CheckedChanged="OnOptionChecked"
                                         IsChecked="{Binding IsSelected}"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Start"
                                         TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}"/>

                            <!-- Контент опции -->
                            <Grid Grid.Column="1" x:Name="OptionContentGrid">

                                <!-- Изображение -->
                                <controls:ZoomableImage 
                                    IsVisible="{Binding IsImage}"
                                    Source="{Binding Text}" 
                                    MaxHeight="75"
                                    MaxWidth="150"/>

                                <!-- Текст с inline-формулами (MathRichText) -->
                         <!--   <mathControls:MathRichText 
                                    IsVisible="{Binding IsImage, Converter={StaticResource InverseBoolConverter}}"
                                    Text="{Binding Text}"
                                    TextSize="16"
                                    BaseHeight="40"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center"/>   -->

                                <ScrollView 
                                    Orientation="Vertical"
                                    IsVisible="{Binding IsImage, Converter={StaticResource InverseBoolConverter}}"
                                    MaximumHeightRequest="180"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Fill">

                                    <mathControls:MathRichText 
                                        Text="{Binding Text}"
                                        TextSize="16"
                                        BaseHeight="40"
                                        HorizontalOptions="Fill"
                                        
                                        VerticalOptions="Center"/>
                                    <!-- WidthRequest="{OnIdiom Phone=220, Tablet=600, Desktop=800}" -->
                                </ScrollView>

                            </Grid>

                        </Grid>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </StackLayout>

        </ScrollView>

    </VerticalStackLayout>

</components:QuestionBase>