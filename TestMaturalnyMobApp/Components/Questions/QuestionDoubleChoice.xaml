<?xml version="1.0" encoding="utf-8" ?>
<components:QuestionBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:components="clr-namespace:TestMaturalnyMobApp.Components.Questions"
                         x:Class="TestMaturalnyMobApp.Components.Questions.QuestionDoubleChoice"
                         x:Name="this">

    <VerticalStackLayout Spacing="8">

        <Label Text="Введіть дві правильні відповіді:" 
           FontSize="14" 
           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}"/>

        <!-- Первая відповідь -->
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightOptionsBackgroundColor}, Dark={StaticResource DarkOptionsBackgroundColor}}"
              Padding="8,4"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">

            <Label Grid.Column="0"
                   Text="1)"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightOptionsTextColor}, Dark={StaticResource DarkOptionsTextColor}}"/>

            <Entry Grid.Column="1"
                   x:Name="FirstAnswerEntry"
                   Placeholder="Введіть першу відповідь"
                   Text="{Binding FirstAnswer, Source={x:Reference this}}"
                   Keyboard="Numeric"
                   TextColor="{AppThemeBinding Light={StaticResource LightOptionsTextColor}, Dark={StaticResource DarkOptionsTextColor}}"/>
        </Grid>

        <!-- Друга відповідь -->
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightOptionsBackgroundColor}, Dark={StaticResource DarkOptionsBackgroundColor}}"
              Padding="8,4"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">

            <Label Grid.Column="0"
                   Text="2)"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightOptionsTextColor}, Dark={StaticResource DarkOptionsTextColor}}"/>

            <Entry Grid.Column="1"
                   x:Name="SecondAnswerEntry"
                   Placeholder="Введіть другу відповідь"
                   Text="{Binding SecondAnswer, Source={x:Reference this}}"
                   Keyboard="Numeric"
                   TextColor="{AppThemeBinding Light={StaticResource LightOptionsTextColor}, Dark={StaticResource DarkOptionsTextColor}}"/>
        </Grid>

    </VerticalStackLayout>


</components:QuestionBase>