<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========== ОСНОВНЫЕ СТИЛИ ========== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPageBackgroundColor}, Dark={StaticResource DarkPageBackgroundColor}}" />
    </Style>

    <!-- ========== СТИЛИ ДЛЯ LABEL ========== -->

    <!-- ✅ ДОБАВЛЯЕМ TitleStyle -->
    <Style TargetType="Label" x:Key="TitleStyle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="H1Style">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="H2Style">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubtitleStyle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="BodyTextStyle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Стиль для текста внутри чипа -->
    <Style TargetType="Label" x:Key="ChipLabelStyle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="#000000" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ========== СТИЛИ ДЛЯ FRAME ========== -->

    <Style TargetType="Frame" x:Key="CardStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightCardBackgroundColor}, Dark={StaticResource DarkCardBackgroundColor}}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="BorderColor" Value="Transparent" />
    </Style>

    <!-- Стили для чипов (Frame) -->
    <Style TargetType="Frame" x:Key="ChipFrameStyle">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Frame" x:Key="ChipVideoStyle" BasedOn="{StaticResource ChipFrameStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightReactVideoLabel}, Dark={StaticResource DarkReactVideoLabel}}" />
    </Style>

    <Style TargetType="Frame" x:Key="ChipPodcastStyle" BasedOn="{StaticResource ChipFrameStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightReactPodcastLabel}, Dark={StaticResource DarkReactPodcastLabel}}" />
    </Style>

    <Style TargetType="Frame" x:Key="ChipQuizStyle" BasedOn="{StaticResource ChipFrameStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightReactQuizLabel}, Dark={StaticResource DarkReactQuizLabel}}" />
    </Style>

    <!-- ========== СТИЛИ ДЛЯ BUTTON ========== -->

    <Style TargetType="Button" x:Key="PrimaryButtonStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightPrimaryButtonBg}, Dark={StaticResource DarkPrimaryButtonBg}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightPrimaryButtonText}, Dark={StaticResource DarkPrimaryButtonText}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButtonStyle">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryButtonBg}, Dark={StaticResource DarkSecondaryButtonBg}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryButtonText}, Dark={StaticResource DarkSecondaryButtonText}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="Button" x:Key="TextButtonStyle">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>